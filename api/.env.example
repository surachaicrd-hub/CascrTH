DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
PORT=3000

# REQUIRED — Server will not start without these
JWT_SECRET=generate_a_strong_random_string_at_least_32_chars

# Optional — for external API integrations
EXPORT_API_KEY=generate_a_separate_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id
GEMINI_API_KEY=your_gemini_api_key

# Email Server (SMTP) Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# iPay Payment Gateway
IPAY_MERCHANT_ID=your_merchant_id
IPAY_CURR_CODE=764
IPAY_PAY_TYPE=N
IPAY_LANG=T
IPAY_PAY_METHOD=CC
IPAY_GATEWAY_URL=https://ipay.bangkokbank.com/b2c/eng/payment/payForm.jsp

# Redis Caching (Optional - If not configured, in-memory cache will be used automatically)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Or REDIS_URL=redis://default:password@127.0.0.1:6379

# Environment (development | production)
NODE_ENV=production
